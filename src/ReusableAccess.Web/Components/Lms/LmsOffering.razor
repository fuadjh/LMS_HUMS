@page "/lms/offer/{Id:guid}/{View}"
@attribute [Authorize]
@inherits LmsPage

<PageTitle>@(_details?.Offering.Course ?? "ارائهٔ درس")</PageTitle>
<div class="@Panel">
    <header class="lms-head">
        <h1>@(_details?.Offering.Course ?? "ارائهٔ درس")</h1>
        @if (_details is { } d) { <p>گروه @Fa(d.Offering.Group) · @Fa(d.Offering.Term) · استاد مسئول @d.Offering.Lead</p> }
        <a href="@($"/lms/offerings/{(View == "preview" ? "teacher" : View)}")" style="color:white">بازگشت به ارائه‌ها</a>
    </header>
    @if (Busy) { <MudProgressLinear Indeterminate="true" /> }
    @if (Error is not null && !_editor && !_confirm && !_lessonOpen && !_gradeOpen && !_rosterOpen && !_templates && !_teachers)
    { <MudAlert Severity="Severity.Error">@Error</MudAlert> }
    @if (_details is { } dd)
    {
        var o = dd.Offering;
        <div class="lms-card">
            <div class="lms-row"><span class="lms-pill">@Audience(o.Audience)</span>
                @if (View == "student") { <span class="lms-pill lms-ok">@State(o.Status)</span> }
                @if (dd.ReadOnly) { <span class="lms-pill lms-warn">فقط‌خواندنی</span> }
                @if (!o.Active) { <span class="lms-pill">بایگانی‌شده</span> }
            </div>
            @if (View == "preview") { <p>پیش‌نمایش: زمان‌بندی و وضعیت انتشار رعایت می‌شود و هیچ فعالیت آموزشی ثبت نمی‌شود.</p> }
            @if (View is "teacher" or "admin") { <p class="lms-muted">نمایش از: <bdi>@DateText(o.VisibleUtc)</bdi> · @Publication(o)</p> }
            @if (View == "student") { <p class="lms-muted">پایان حذف‌واضافه: <bdi>@DateText(o.DropClosesUtc)</bdi></p> }
            <div class="lms-row">
                @if (o.CanEnroll) { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AskJoin">اخذ درس</MudButton> }
                @if (o.CanWithdraw) { <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="AskExit">خروج در حذف‌واضافه</MudButton> }
                @if (View is "admin" or "teacher") { <MudButton Variant="Variant.Outlined" OnClick="Roster">فهرست ثبت‌نام‌ها</MudButton> }
                @if (View == "admin") { <MudButton Variant="Variant.Outlined" OnClick="Teachers">هم‌مدرس‌ها</MudButton> }
                @if (dd.TeacherEditor)
                {
                    <MudButton OnClick="EditSchedule">زمان نمایش</MudButton>
                }
                @if (dd.CanPublish && o.PublishedUtc is null) { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AskPublish">انتشار ارائه</MudButton> }
                @if (View == "teacher")
                {
                    <MudButton Href="@($"/lms/offer/{Id:D}/preview")">پیش‌نمایش دانشجو</MudButton>
                    <MudButton Href="@($"/lms/offer/{Id:D}/schedule-view")">تقویم واقعی و سابقه</MudButton>
                    @if (dd.TeacherEditor && _home?.ScheduleStudioEnabled == true && Can(LmsPermissions.Template) &&
                         SelectedTab == "content" && dd.Chapters.Length == 0 && o.PublishedUtc == null)
                    {
                        <MudButton Variant="Variant.Outlined" Href="@($"/lms/templates?course={o.CourseId:D}&target={Id:D}")">تنظیم تقویم از بانک الگو</MudButton>
                    }
                    @if (SelectedTab == "content" && dd.Lead && Can(LmsPermissions.Template)) { <MudButton OnClick="Templates">قالب خصوصی</MudButton> }
                }
            </div>
        </div>
        <nav class="ra-offer-tabs" aria-label="بخش‌های ارائه">
            @foreach (var tab in Sections)
            {
                <a @key="tab.Key" class="ra-offer-tab" aria-current="@(SelectedTab == tab.Key ? "page" : null)"
                   href="@($"/lms/offer/{Id:D}/{View}?tab={tab.Key}")">@tab.Label</a>
            }
        </nav>
        @if (SelectedTab == "online")
        {
            <section class="lms-card"><span class="lms-pill">صرفاً نمایشی</span><h2>جلسات کلاس آنلاین</h2>
                <p>در این نسخه کلاس آنلاین به دادهٔ واقعی یا سرویس برگزاری وصل نیست. محتوای آموزشی و تکلیف به این بخش وابسته نیستند.</p>
            </section>
        }
        else if (View == "admin")
        {
            <section class="lms-card"><p>این پنل برای مدیریت رسمی گروه و ثبت‌نام است. دسترسی به فعالیت‌های درس در پنل استاد و دانشجوی مجاز است.</p></section>
        }
        else if (SelectedTab == "assignments")
        {
            <LmsAssignmentWorkspace @key="Id" OfferingId="@Id" View="@View" InitialAssignmentId="@AssignmentId"
                                    CanGrade="@dd.CanGrade" CanRelease="@dd.CanRelease" CanUseTemplates="@Can(LmsPermissions.Template)" />
        }
        else if (SelectedTab == "discussion")
        {
            @if (View == "preview" || View == "student" && (o.Status != EnrollmentStatus.Active || !Can(LmsPermissions.Chat)))
            { <section class="lms-card"><p>گفتگو فقط در نشست واقعی استاد یا دانشجوی مجاز همین گروه قابل‌مشاهده است.</p></section> }
            else
            { <LmsCourseDiscussion @key="Id" OfferingId="@Id" View="@View" /> }
        }
        else
        {
            @if (dd.TeacherEditor)
            { <MudButton Color="Color.Primary" OnClick="() => EditChapter(null)">فصل جدید</MudButton> }
            <div class="lms-grid">
                @foreach (var c in dd.Chapters)
                {
                    <section class="lms-card" @key="c.Id">
                        <div class="lms-row"><span class="lms-pill">فصل @Fa(c.Position)</span>
                            @if (View == "teacher") { <span class="lms-pill">@(c.PublishedUtc.HasValue ? "منتشرشده" : c.Active ? "پیش‌نویس" : "بایگانی")</span> }
                        </div>
                        <h2>@c.Title</h2>
                        @if (c.OpensUtc.HasValue || c.ClosesUtc.HasValue)
                        {
                            <p class="lms-muted">نمایش فصل: <bdi>@DateText(c.OpensUtc)</bdi> تا <bdi>@DateText(c.ClosesUtc)</bdi></p>
                        }
                        @foreach (var lesson in c.Lessons)
                        {
                            <div class="lms-row" @key="lesson.Id">
                                @if (lesson.CoverMediaId is { } cover)
                                { <img src="@FileUrl(cover)" alt="کاور ویدئوی درسک" width="64" height="48" loading="lazy" style="object-fit:cover;border-radius:.4rem" /> }
                                <span>@lesson.Title</span>
                                @if (lesson.Completed) { <span class="lms-pill lms-ok">تکمیل شده</span> }
                                @if (!lesson.CanRead && lesson.ClosesUtc is { } close && close <= DateTimeOffset.UtcNow)
                                { <small class="lms-muted">دسترسی پایان یافته است.</small> }
                                else if (!lesson.CanRead) { <small class="lms-muted">هنوز در دسترس نیست · <bdi>@DateText(lesson.OpensUtc)</bdi></small> }
                                else
                                {
                                    <MudButton OnClick="() => ShowLesson(c, lesson)">بازکردن درسک</MudButton>
                                    @if (lesson.ClosesUtc is { } until) { <small class="lms-muted">پایان دسترسی: <bdi>@DateText(until)</bdi></small> }
                                }
                                @if (lesson.NeedsAvailabilityReview) { <span class="lms-pill lms-warn">بازبینی دسترسی لازم است</span> }
                                @if (dd.TeacherEditor && c.PublishedUtc is null) { <MudButton OnClick="() => EditLesson(c, lesson)">ویرایش</MudButton> }
                                @if (dd.TeacherEditor && c.PublishedUtc is not null && lesson.NeedsAvailabilityReview && lesson.Active)
                                { <MudButton OnClick="() => EditLesson(c, lesson, true)">تنظیم دسترسی مستقل</MudButton> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lesson.Summary)) { <p class="lms-muted">@lesson.Summary</p> }
                        }
                        @if (c.PublishedUtc is null && View == "teacher")
                        {
                            <div class="lms-row">
                                @if (dd.TeacherEditor)
                                {
                                    <MudButton OnClick="() => EditChapter(c)">ویرایش فصل</MudButton>
                                    <MudButton OnClick="() => EditLesson(c, null)">افزودن درسک</MudButton>
                                }
                                @if (dd.CanPublish && c.Active) { <MudButton Color="Color.Primary" OnClick="() => AskChapter(c)">انتشار فصل</MudButton> }
                            </div>
                        }
                    </section>
                }
            </div>
            @if (dd.Chapters.Length == 0) { <p class="lms-muted">در این نما هنوز فصلی قابل نمایش نیست.</p> }
        }
    }
</div>

<LmsDialog @bind-Visible="_confirm" Title="@_confirmTitle" Lead="@_confirmImpact" Busy="@Busy" Error="@Error" OnSave="Confirm" SaveText="تأیید عملیات">
    @if (_reasonNeeded) { <label>دلیل حذف مدیریتی<textarea @bind="_reason" maxlength="500"></textarea></label> }
</LmsDialog>
<LmsDialog @bind-Visible="_editor" Title="@_editTitle" Busy="@Busy" Error="@Error" OnSave="SaveEdit" Lead="زمان‌ها جلالی و به وقت تهران‌اند. فصل منتشرشده برای حفظ سوابق فقط خواندنی است.">
    @if (_kind == "schedule")
    { <PersianDateField Label="زمان دیده‌شدن ارائه" @bind-Value="_time" PreferredTime="@(new TimeOnly(8, 0))" Disabled="@Busy" /> }
    else
    {
        @if (_kind != "legacy-availability")
        {
            <label>عنوان<input @bind="_title" maxlength="180" /></label>
            <label>ترتیب<input type="number" min="1" max="1000" @bind="_position" /></label>
            @if (_kind == "lesson") { <label>متن درسک<textarea @bind="_body" maxlength="32000"></textarea></label> }
            <label class="lms-inline"><input type="checkbox" @bind="_sectionActive" /> فعال (بدون حذف رکورد)</label>
        }
        @if (_kind == "legacy-availability") { <p class="lms-muted">متن منتشرشده تغییر نمی‌کند؛ ثبت این بازه دسترسی مستقل را تأیید می‌کند.</p> }
        <div class="lms-grid">
            <PersianDateField Label="آغاز نمایش (اختیاری)" @bind-Value="_time" PreferredTime="@(new TimeOnly(8, 0))" Disabled="@Busy" />
            <PersianDateField Label="پایان انحصاری نمایش (اختیاری)" @bind-Value="_contentEnd" Disabled="@Busy" />
        </div>
        <p class="lms-muted">روز بدون ساعت برای شروع یعنی ۰۸:۰۰ تهران؛ برای پایان یعنی قبل از شروع روز بعد.</p>
    }
</LmsDialog>
<LmsDialog @bind-Visible="_lessonOpen" Title="@(_lesson?.Title ?? "درسک")" Error="@Error" Busy="@Busy">
    @if (_lesson is { } l)
    {
        @if (!string.IsNullOrWhiteSpace(l.Summary)) { <p class="lms-muted">@l.Summary</p> }
        <p class="lms-plain">@l.Body</p>
        @foreach (var f in l.Files)
        {
            @if (f.Extension == ".mp4") { <video controls preload="metadata" src="@FileUrl(f.Id)" poster="@(l.CoverMediaId is { } posterId ? FileUrl(posterId) : null)" style="display:block;width:100%;max-height:50vh"></video> }
            <p><a class="lms-file" href="@FileUrl(f.Id)" target="_blank" rel="noopener">@f.Name · @Size(f.Bytes)</a></p>
        }
        @if (View == "teacher" && _details?.TeacherEditor == true && _chapter?.PublishedUtc is null && Can(LmsPermissions.LessonUpload))
        { <LmsUpload @key="l.Id" TargetId="@l.Id" Purpose="MediaPurpose.LessonMaterial" Uploaded="LessonFileReady" /> }
        @if (View == "student" && _details?.ReadOnly == false && !l.Completed && Can(LmsPermissions.Progress))
        { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Done" Disabled="@Busy">علامت‌گذاری تکمیل درسک</MudButton> }
    }
</LmsDialog>
<LmsDialog @bind-Visible="_rosterOpen" Title="فهرست ثبت‌نام‌ها" Busy="@Busy" Error="@Error" Lead="خروج از درس صرفاً وضعیت ثبت‌نام را تغییر می‌دهد.">
    <label>جستجو در فهرست<input @bind="_rosterSearch" @bind:event="oninput" /></label>
    @foreach (var r in _roster.Where(x => $"{x.Name} {x.Number}".Contains(_rosterSearch, StringComparison.OrdinalIgnoreCase)))
    {
        <article class="lms-card my-2">
            <h3>@r.Name</h3><p>@r.StudyLabel · @r.Number · @State(r.Status)</p>
            @if (View == "admin") { <MudButton OnClick="() => History(r)">تاریخچهٔ وضعیت</MudButton> }
            @if (r.CanRemove) { <MudButton Color="Color.Error" OnClick="() => AskRemove(r)">حذف مدیریتی</MudButton> }
            @if (View == "teacher" && _details?.Lead == true && (Can(LmsPermissions.Grade) || Can(LmsPermissions.Release)))
            { <MudButton OnClick="() => OpenFinal(r)">نمرهٔ پایانی غیررسمی</MudButton> }
        </article>
    }
    @if (_roster.Length == 0) { <p>ثبت‌نامی یافت نشد.</p> }
</LmsDialog>
<LmsDialog @bind-Visible="_history" Title="تاریخچهٔ ثبت‌نام" Error="@Error" Busy="@Busy">
    @foreach (var item in _enrollmentHistory) { <p>@State(item.Status) · @DateText(item.OccurredUtc)</p><p class="lms-plain">@item.Reason</p> }
</LmsDialog>
<LmsDialog @bind-Visible="_teachers" Title="تدریس گروهی" Error="@Error" Busy="@Busy" Lead="نمای دانشجو محتوای استاد مسئول را نشان می‌دهد. اختیار هم‌مدرس باید صریح ثبت شود.">
    @foreach (var c in _details?.CoTeachers ?? [])
    { <div class="lms-row"><strong>@c.DisplayName</strong><span>@(c.Active ? "فعال" : "غیرفعال")</span><MudButton OnClick="() => SelectCo(c)">ویرایش اختیار</MudButton></div> }
    @if (_details?.ReadOnly == false)
    {
        <LmsChoice Label="هم‌مدرس" Options="@_teacherOptions" @bind-Value="_coId" />
        <label class="lms-inline"><input type="checkbox" @bind="_coGrade" /> تصحیح تکلیف با مجوز نقش</label>
        <label class="lms-inline"><input type="checkbox" @bind="_coPublish" /> انتشار محتوای استاد مسئول با مجوز نقش</label>
        <label class="lms-inline"><input type="checkbox" @bind="_coActive" /> فعال باشد</label>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCo" Disabled="@Busy">ثبت تخصیص</MudButton>
    }
</LmsDialog>
<LmsDialog @bind-Visible="_templates" Title="قالب خصوصی و نسخه‌ها" Error="@Error" Busy="@Busy" Lead="فقط طرح، متن و فایل درسک ذخیره می‌شود؛ تکلیف و سابقهٔ دانشجو جدا هستند.">
    <LmsChoice Label="قالب موجود یا قالب جدید" Options="@TemplateOptions" @bind-Value="_template" EmptyText="قالب جدید" />
    <label>نام قالب تازه<input @bind="_templateName" disabled="@_template.HasValue" /></label>
    <MudButton OnClick="SaveTemplate" Disabled="@Busy">ذخیرهٔ نسخهٔ تازه</MudButton>
    @if (_details is { } ts && !ts.ReadOnly && ts.Chapters.Length == 0 && ts.Offering.PublishedUtc is null)
    {
        <LmsChoice Label="نسخه برای این پیش‌نویس خالی" Options="@VersionOptions" @bind-Value="_version" />
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="AskApply" Disabled="@Busy">استفاده از نسخه</MudButton>
    }
</LmsDialog>
<LmsDialog @bind-Visible="_gradeOpen" Title="نمرهٔ پایانی غیررسمی" Busy="@Busy" Error="@Error" Lead="پیش‌نویس برای دانشجو مخفی است. انتشار، نتیجه را فقط برای همان دانشجو قابل‌مشاهده می‌کند.">
    <p>@_gradedName</p>
    @if (_details?.CanGrade == true || _details?.CanRelease == true)
    {
        <label>نمره از ۲۰<input type="number" step="0.01" min="0" max="20" @bind="_score" /></label>
        <label>بازخورد خصوصی<textarea @bind="_feedback" maxlength="8000"></textarea></label>
        <div class="lms-row">
            @if (_details.CanGrade) { <MudButton Variant="Variant.Outlined" OnClick="DraftGrade" Disabled="@Busy">ذخیرهٔ پیش‌نویس</MudButton> }
            @if (_details.CanRelease) { <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AskRelease" Disabled="@Busy">تأیید انتشار نتیجه</MudButton> }
        </div>
    }
    <details><summary>سابقهٔ نسخه‌ها (@Fa(_gradeHistory.Length))</summary>
        @foreach (var g in _gradeHistory)
        { <p>نسخه @Fa(g.Revision) · @Fa(g.Score) · @DateText(g.CreatedUtc) · @(g.Published ? "منتشرشده" : "پیش‌نویس")</p><p class="lms-plain">@g.Feedback</p> }
    </details>
</LmsDialog>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string View { get; set; } = "student";
    private string Panel => View == "admin" ? "lms lms-admin" : View == "teacher" ? "lms lms-teacher" : "lms";
    private string Root => $"offerings/{Id:D}";
    private LmsHome? _home;
    private OfferingDetails? _details;
    private ChapterRow? _chapter;
    private LessonRow? _lesson;
    private RosterRow[] _roster = [];
    private EnrollmentHistoryRow[] _enrollmentHistory = [];
    private bool _history;
    private TemplateRow[] _versions = [];
    private CatalogRow[] _teacherOptions = [];
    private CatalogRow[] TemplateOptions => _versions.GroupBy(x => x.Id).Select(x => new CatalogRow(x.Key, x.First().Title)).ToArray();
    private CatalogRow[] VersionOptions => _versions.Select(x => new CatalogRow(x.VersionId, $"{x.Title} · نسخه {Fa(x.Version)}")).ToArray();
    private bool _confirm, _editor, _lessonOpen, _rosterOpen, _gradeOpen, _templates, _teachers;
    private bool _reasonNeeded, _sectionActive, _coGrade, _coPublish, _coActive;
    private Guid? _editId, _parent, _template, _version, _coId;
    private Guid _gradedId;
    private int _position;
    private decimal _score;
    private string _confirmTitle = "", _confirmImpact = "", _reason = "", _editTitle = "", _kind = "", _title = "", _body = "", _feedback = "", _gradedName = "", _rosterSearch = "", _templateName = "";
    private string? _time, _contentEnd;
    private GradeRow[] _gradeHistory = [];
    private Func<Task>? _saveConfirmed;
    private bool Can(string permission) => _home?.Permissions.Contains(permission) == true;
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "assessment")] public Guid? AssignmentId { get; set; }
    private static readonly (string Key, string Label)[] Sections =
        [("content", "محتوای آموزشی"), ("online", "کلاس آنلاین"), ("assignments", "تکلیف"), ("discussion", "گفتگوی درسی")];
    private string SelectedTab => Tab is "online" or "assignments" or "discussion" ? Tab : "content";
    protected override Task OnParametersSetAsync() => Run(async () =>
    {
        _details = null; _confirm = _editor = _lessonOpen = _rosterOpen = _gradeOpen = _templates = _teachers = false;
        if (View is not ("student" or "admin" or "teacher" or "preview")) throw new ArgumentException("نمای نامعتبر است.");
        _home = await Get<LmsHome>("me"); await Load();
    });
    private async Task Load()
    {
        var id = Id;
        var view = View;
        var tab = SelectedTab;
        var includeContent = tab == "content" && view != "admin" ? "true" : "false";
        var result = await Get<OfferingDetails>($"offerings/{id:D}?view={view}&includeContent={includeContent}");
        if (id == Id && view == View && tab == SelectedTab) _details = result;
    }
    private static string Publication(OfferingRow o) => !o.Active ? "بایگانی" : o.Closed ? "پایان‌یافته" :
        o.PublishedUtc is null ? "منتشر نشده" : o.VisibleUtc is null || o.VisibleUtc > DateTimeOffset.UtcNow ? "منتشرشده؛ در انتظار نمایش" : "قابل مشاهده";
    private static string FileUrl(Guid id) => $"/bff/lms/files/{id:D}";
    private void Ask(string title, string impact, Func<Task> action, bool reason = false)
    { _confirmTitle = title; _confirmImpact = impact; _reasonNeeded = reason; _reason = ""; _saveConfirmed = action; _confirm = true; }
    private Task Confirm() => Run(async () => { if (_saveConfirmed is not null) await _saveConfirmed(); _confirm = false; });
    private void AskJoin() => Ask("اخذ درس", "درخواست دوباره با مقررات نیم‌سال و ورودی بررسی می‌شود.", async () =>
    { var c = await Post<EnrollmentChange>($"{Root}/join"); Snack.Add(c.Changed ? "درس اخذ شد." : "درس از پیش اخذ شده بود.", Severity.Success); await Load(); });
    private void AskExit()
    {
        if (_details?.Offering.EnrollmentId is not { } e) return;
        Ask("خروج از درس", "دسترسی جاری متوقف می‌شود. ثبت‌نام، تحویل، نمره و پیشرفت پاک نمی‌شوند. ثبت مجدد خودکار نیست.", async () =>
        { var c = await Post<EnrollmentChange>($"enrollments/{e:D}/withdraw"); Snack.Add(c.Changed ? "خروج دانشجویی ثبت شد." : "خروج قبلاً ثبت شده بود.", Severity.Success); await Load(); });
    }
    private void AskRemove(RosterRow r)
    {
        _rosterOpen = false;
        Ask($"حذف مدیریتی: {r.Name}", "ثبت‌نام به «حذف توسط مدیر» تغییر می‌کند. سابقه، نمره و تکلیف باقی می‌مانند.", async () =>
        { var c = await Post<EnrollmentChange>($"enrollments/{r.EnrollmentId:D}/remove", new RemoveEnrollmentInput(_reason)); Snack.Add(c.Changed ? "حذف مدیریتی ثبت شد." : "حذف قبلاً ثبت شده بود.", Severity.Success); await LoadRoster(); _rosterOpen = true; }, true);
    }
    private void AskPublish() => Ask("انتشار ارائه", "در تاریخ نمایش، اطلاعات ارائه برای واجدان شرایط دیده می‌شود. زمان شروع مطالعه و تکلیف مستقل است.", async () =>
    { _ = await Post<bool>($"{Root}/publish"); Snack.Add("ارائه منتشر شد.", Severity.Success); await Load(); });
    private void AskChapter(ChapterRow c) => Ask("انتشار فصل", "فصل به ارائه افزوده می‌شود؛ ترتیب و محتوای آن پس از انتشار ثابت می‌مانند.", async () =>
    { _ = await Post<bool>($"{Root}/chapters/{c.Id:D}/publish"); Snack.Add("فصل منتشر شد.", Severity.Success); await Load(); });
    private void Edit(string kind, string title, Guid? id, Guid? parent, string? contentTitle, bool active = true, int order = 1)
    {
        _kind = kind; _editTitle = title; _editId = id; _parent = parent; _title = contentTitle ?? ""; _sectionActive = active; _position = order;
        _time = _contentEnd = null; _body = ""; _editor = true;
    }
    private void EditSchedule() { Edit("schedule", "زمان نمایش ارائه", null, null, null); _time = DateInput(_details?.Offering.VisibleUtc); }
    private void EditChapter(ChapterRow? c)
    {
        Edit("chapter", "فصل ارائه", c?.Id, null, c?.Title, c?.Active ?? true, c?.Position ?? ((_details?.Chapters.LastOrDefault()?.Position ?? 0) + 1));
        _time = DateInput(c?.OpensUtc); _contentEnd = DateInput(c?.ClosesUtc);
    }
    private void EditLesson(ChapterRow c, LessonRow? l, bool legacy = false)
    {
        Edit(legacy ? "legacy-availability" : "lesson", "دسترسی مستقل درسک", l?.Id, c.Id, l?.Title, l?.Active ?? true,
            l?.Position ?? ((c.Lessons.LastOrDefault()?.Position ?? 0) + 1));
        _body = l?.Body ?? ""; _time = DateInput(l?.OwnOpensUtc); _contentEnd = DateInput(l?.OwnClosesUtc);
    }
    private Task SaveEdit() => Run(async () =>
    {
        var start = AvailabilityDate(_time);
        if (_kind == "schedule") _ = await Post<bool>($"{Root}/schedule", new ScheduleEdit(start ?? throw new ArgumentException("زمان نمایش لازم است.")));
        else _ = await Post<Guid>($"{Root}/content/{_kind}", new SectionEdit(_editId, _parent, _title, _position, _body,
            start, AvailabilityDate(_contentEnd, true), _sectionActive));
        _editor = false; Snack.Add("اطلاعات ارائه ثبت شد.", Severity.Success); await Load();
    });
    private void ShowLesson(ChapterRow c, LessonRow l) { _chapter = c; _lesson = l; _lessonOpen = true; }
    private async Task RefreshLesson()
    {
        await Load(); _chapter = _details?.Chapters.FirstOrDefault(c => c.Id == _chapter?.Id);
        _lesson = _chapter?.Lessons.FirstOrDefault(l => l.Id == _lesson?.Id);
    }
    private Task LessonFileReady(FileRow _) => Run(RefreshLesson);
    private Task Done() => Run(async () =>
    { if (_lesson is not { } l) return; _ = await Post<bool>($"lessons/{l.Id:D}/done"); Snack.Add("پیشرفت ثبت شد.", Severity.Success); await RefreshLesson(); });
    private Task Roster() => Run(async () => { await LoadRoster(); _rosterSearch = ""; _rosterOpen = true; });
    private Task History(RosterRow row) => Run(async () =>
    { _enrollmentHistory = await Get<EnrollmentHistoryRow[]>($"enrollments/{row.EnrollmentId:D}/history?view=admin"); _rosterOpen = false; _history = true; });
    private async Task LoadRoster() => _roster = await Get<RosterRow[]>($"{Root}/roster?view={View}");
    private Task Teachers() => Run(async () =>
    {
        _teacherOptions = _details?.ReadOnly == false ? (await Get<PeopleRow[]>("people/teacher")).Where(t => t.UserId != _details?.Offering.LeadId && t.ProfileActive && t.AccountActive)
            .Select(t => new CatalogRow(t.UserId, t.DisplayName)).ToArray() : [];
        _coId = null; _coActive = true; _coGrade = _coPublish = false; _teachers = true;
    });
    private void SelectCo(CoTeacherRow c) { _coId = c.InstructorId; _coActive = c.Active; _coGrade = c.CanGrade; _coPublish = c.CanPublish; }
    private Task SaveCo() => Run(async () =>
    {
        if (_coId is not { } id) throw new ArgumentException("هم‌مدرس را انتخاب کنید.");
        _ = await Post<Guid>($"{Root}/co-teachers", new CoTeacherEdit(id, _coGrade, _coPublish, _coActive));
        Snack.Add("تخصیص ثبت شد.", Severity.Success); await Load();
    });
    private Task Templates() => Run(async () => { await LoadTemplates(); _template = _version = null; _templateName = ""; _templates = true; });
    private async Task LoadTemplates() => _versions = (await Get<TemplateRow[]>("templates")).Where(t => t.CourseId == _details?.Offering.CourseId).ToArray();
    private Task SaveTemplate() => Run(async () =>
    {
        var title = _template is { } id ? TemplateOptions.Single(x => x.Id == id).Title : _templateName;
        _ = await Post<Guid>($"{Root}/templates/save", new TemplateSave(_template, title)); Snack.Add("نسخهٔ خصوصی ذخیره شد.", Severity.Success); await LoadTemplates();
    });
    private void AskApply()
    {
        if (_version is not { } v) { Snack.Add("نسخه را انتخاب کنید.", Severity.Warning); return; }
        _templates = false;
        Ask("استفاده از قالب", "فقط محتوای پیش‌نویس کپی می‌شود؛ بازه‌های نمایش را مستقل تنظیم کنید.", async () =>
        { _ = await Post<bool>($"{Root}/templates/apply", new TemplateApply(v)); Snack.Add("نسخه در ارائهٔ خالی استفاده شد.", Severity.Success); await Load(); });
    }
    private Task OpenFinal(RosterRow r) => Run(async () =>
    {
        _gradeHistory = await Get<GradeRow[]>($"enrollments/{r.EnrollmentId:D}/grade");
        _gradedId = r.EnrollmentId; _gradedName = r.Name; _rosterOpen = false; _gradeOpen = true;
        _score = _gradeHistory.FirstOrDefault()?.Score ?? 0; _feedback = _gradeHistory.FirstOrDefault()?.Feedback ?? "";
    });
    private Task DraftGrade() => Run(() => SaveGrade(false));
    private async Task SaveGrade(bool publish)
    {
        var endpoint = $"enrollments/{_gradedId:D}/grade";
        _ = await Post<Guid>(endpoint, new GradeEdit(_score, _feedback, publish));
        Snack.Add(publish ? "نمره و بازخورد منتشر شد." : "پیش‌نویس تصحیح ذخیره شد.", Severity.Success);
        _gradeHistory = await Get<GradeRow[]>(endpoint);
        _gradeOpen = true;
    }
    private void AskRelease()
    {
        _gradeOpen = false;
        Ask("انتشار نتیجه", $"نمرهٔ {Fa(_score)} برای همان دانشجو قابل‌مشاهده می‌شود؛ سابقهٔ نسخه‌ها باقی می‌ماند.", () => SaveGrade(true));
    }
}
