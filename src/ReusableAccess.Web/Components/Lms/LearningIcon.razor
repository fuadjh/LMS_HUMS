<img class="learning-icon @Class" src="@($"/learning/icon-{Name}.svg")" width="@Size" height="@Size" alt="" aria-hidden="true" />
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "text";
    [Parameter] public int Size { get; set; } = 17;
    [Parameter] public string? Class { get; set; }
}
