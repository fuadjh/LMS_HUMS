<AppModal Visible="@Visible" VisibleChanged="OnVisible" Title="@Title" Lead="@Lead" Error="@Error"
          Width="MaxWidth.Medium" CssClass="lms-dialog" Busy="@(Busy || _saving)" AllowEscape="@(!OnSave.HasDelegate)">
    <ChildContent>@ChildContent</ChildContent>
    <Actions>
        <MudButton Disabled="@(Busy || _saving)" OnClick="() => OnVisible(false)">@(OnSave.HasDelegate ? "انصراف" : "بستن")</MudButton>
        @if (OnSave.HasDelegate)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(Busy || _saving)" OnClick="Save">@SaveText</MudButton>
        }
    </Actions>
</AppModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "سامانهٔ یادگیری";
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string SaveText { get; set; } = "ثبت";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _saving;
    private Task OnVisible(bool v) => Busy || _saving ? Task.CompletedTask : VisibleChanged.InvokeAsync(v);
    private async Task Save()
    {
        if (Busy || _saving || !OnSave.HasDelegate) return;
        _saving = true;
        try { await OnSave.InvokeAsync(); }
        finally { _saving = false; }
    }
}
