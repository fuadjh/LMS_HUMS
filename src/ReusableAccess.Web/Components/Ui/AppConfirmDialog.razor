@using MudBlazor
<AppModal Visible="@Visible" VisibleChanged="VisibleChanged" Title="@Title" Busy="@(Busy || _confirming)">
    <ChildContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text">@Message</MudAlert>
    </ChildContent>
    <Actions>
        <MudButton Disabled="@(Busy || _confirming)" OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" Disabled="@(Busy || _confirming)" OnClick="Confirm">@ConfirmText</MudButton>
    </Actions>
</AppModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "تأیید عملیات";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "تأیید عملیات";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Error;
    private bool _confirming;
    private Task Cancel() => Busy || _confirming ? Task.CompletedTask : VisibleChanged.InvokeAsync(false);
    private async Task Confirm()
    {
        if (Busy || _confirming || !OnConfirm.HasDelegate) return;
        _confirming = true;
        try { await OnConfirm.InvokeAsync(); }
        finally { _confirming = false; }
    }
}
