@using MudBlazor
@implements IDisposable

<AppFormModal TModel="object" Model="@Model" Visible="@Visible" VisibleChanged="VisibleChanged"
              Title="@Title" Width="@Width" SaveText="@SaveText" Busy="@(Busy || _opening)"
              CanSave="@CanSave" OnValidSave="Submit">
    <ChildContent Context="formModel">@ChildContent</ChildContent>
</AppFormModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public object Model { get; set; } = new();
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SaveText { get; set; } = "ذخیره";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanSave { get; set; } = true;
    [Parameter] public MaxWidth Width { get; set; } = MaxWidth.Small;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback Opened { get; set; }

    private bool _wasVisible, _pendingOpen, _opening, _disposed;

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _pendingOpen = true;
            _opening = true;
        }
        if (!Visible)
            _pendingOpen = false;

        _wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingOpen || !Visible)
            return;

        _pendingOpen = false;
        try
        {
            await Opened.InvokeAsync();
        }
        finally
        {
            _opening = false;
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private Task Submit(object model) =>
        Busy || _opening || !CanSave
            ? Task.CompletedTask
            : OnSave.InvokeAsync();

    public void Dispose() => _disposed = true;
}