<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UsePersianDatePickerZO Condition="'$(UsePersianDatePickerZO)' == ''">true</UsePersianDatePickerZO>
    <DefineConstants Condition="'$(UsePersianDatePickerZO)' == 'true'">$(DefineConstants);USE_PERSIAN_DATEPICKER_ZO</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>8de4c671-d5ec-47f3-a9f8-bcc201416dec</UserSecretsId>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageReference Include="Blazor_PersianDatePickerZO" Version="3.0.6" Condition="'$(UsePersianDatePickerZO)' == 'true'" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReusableAccess.Contracts\ReusableAccess.Contracts.csproj" />
  </ItemGroup>
           
</Project>
